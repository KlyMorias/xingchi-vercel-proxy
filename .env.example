# Set these in Vercel Project Settings > Environment Variables.
XINGCHI_API_KEY=
# Use "authorization" or "x-api-key" based on Xingchi's account docs.
UPSTREAM_AUTH_MODE=authorization
MAX_OUTPUT_TOKENS=2048
# Private Vercel Blob store connected to this project through OIDC.
BLOB_STORE_ID=
# Separate random secret, at least 32 characters, used for private login counters.
KEY_HASH_SECRET=
# Bootstrap only: password is an scrypt hash, never a plain password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
