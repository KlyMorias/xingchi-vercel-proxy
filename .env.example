# Set these in Vercel Project Settings > Environment Variables.
XINGCHI_SOL_API_KEY=
XINGCHI_ASTRA_API_KEY=
# Optional legacy Sol-only fallback. Never used for Astra.
# XINGCHI_API_KEY=
# Set true only while the last Astra generation test needs dedicated balance.
# XINGCHI_ASTRA_BALANCE_REQUIRED=true
# Use "authorization" or "x-api-key" based on Xingchi's account docs.
UPSTREAM_AUTH_MODE=authorization
DEFAULT_OUTPUT_TOKENS=2048
# Optional administrator ceiling. Leave unset to forward the client's token limit.
# MAX_OUTPUT_TOKENS=32768
# Private Vercel Blob store connected to this project through OIDC.
BLOB_STORE_ID=
# The state store also enforces this to keep SDK write retries disabled.
VERCEL_BLOB_RETRIES=0
# Separate random secret, at least 32 characters, used for private login counters.
KEY_HASH_SECRET=
# Bootstrap only: password is an scrypt hash, never a plain password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
