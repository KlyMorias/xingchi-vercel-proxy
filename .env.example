# Set these in Vercel Project Settings > Environment Variables.
XINGCHI_API_KEY=
PROXY_ACCESS_TOKEN=replace-with-a-random-secret-at-least-32-characters-long
# Use "authorization" or "x-api-key" based on Xingchi's account docs.
UPSTREAM_AUTH_MODE=authorization
MAX_OUTPUT_TOKENS=2048
# A persistent Redis REST database is required for personal keys and quotas.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Separate random secret, at least 32 characters, used to hash creation IPs.
KEY_HASH_SECRET=
